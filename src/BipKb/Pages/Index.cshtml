@page
@model IndexModel
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>bip-kb — connaissance technique</title>
<style>body{font:16px system-ui;max-width:1100px;margin:2rem auto;padding:0 1rem;color:#182438;background:#f5f7fa}nav{display:flex;gap:1.3rem;flex-wrap:wrap;margin:2rem 0}a{color:#1452a0}article,section{background:white;border:1px solid #d9e0e8;border-radius:8px;padding:1.2rem;margin:1rem 0}input,select,textarea,button{font:inherit;padding:.5rem;margin:.3rem}textarea{width:90%}button{background:#1452a0;color:white;border:0;border-radius:4px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f1f4f8;padding:1rem}small{overflow-wrap:anywhere}.warning{color:#8a3500}label{display:block}h1{margin-bottom:0}</style></head><body>
<h1>bip-kb</h1><p>Des connaissances reliées à leurs preuves.</p>
<nav><a href="/?view=search">Rechercher</a><a href="/?view=ingestions">Ingestions</a><a href="/?view=review">Arbitrages</a><a href="/?view=projects">Projets</a><a href="/?view=tasks">Dossiers</a><a href="/?view=questions">Questions et mémoire</a></nav>
@if(Model.Error!=null){<p class="warning">@Model.Error</p>}
@if(Model.View=="projects"){
<h2>Contexte global</h2>
<p>Configurer avec <code>bip-kb project setup</code> ou un fichier de profil partagé.</p>
@foreach(var project in Model.Knowledge.Projects){<article><h3>@project.Name</h3><p>@project.Objective</p><p>@project.Architecture</p><p>Conventions : @string.Join(" ; ",project.Conventions)</p>
@foreach(var domain in project.Domains){<p><strong>@domain.Name</strong> — @domain.Responsibility ; liens : @string.Join(", ",domain.RelatedDomains)</p>}
@foreach(var rule in project.Authorities){<p>Référence pour @rule.Topic : @rule.SourceId — @rule.Reason</p>}
</article>}
}else if(Model.View=="tasks"){
<h2>Dossiers de travail</h2><form method="post" asp-page-handler="Task"><label>Projet <input name="project" required></label><label>Objectif <textarea name="goal" required maxlength="4000"></textarea></label><button>Créer un dossier</button></form>
@foreach(var task in Model.Knowledge.Tasks){<article><a href="/?view=task&amp;id=@task.Id">@task.Goal</a><p>@task.Project — @task.Turns.Count échanges</p></article>}
}else if(Model.View=="task" && Model.SelectedTask is {} selected){
<h2>@selected.Goal</h2><p>@selected.Project — @(Model.Stale?"À actualiser : la mémoire a changé":"Dossier ouvert")</p>
@foreach(var item in selected.Coverage){<p>@item.Name : @(item.Supported?"preuves candidates":"à compléter") — @item.Explanation</p>}
@foreach(var turn in selected.Turns){<article><strong>@turn.Role</strong><pre>@turn.Text</pre><small>Références : @string.Join(", ",turn.Citations)</small></article>}
<form method="post" asp-page-handler="Task"><input type="hidden" name="id" value="@selected.Id"><label>Message ou précision <textarea name="message" maxlength="4000"></textarea></label><button>Rechercher et répondre avec Copilot</button></form>
<p>Une réponse de conversation ne devient pas automatiquement une connaissance validée.</p>
}else if(Model.View=="questions"){
<h2>Questions ouvertes et déclarations humaines</h2>
<form method="post" asp-page-handler="Remember"><label>Projet <input name="project" required></label><label>À retenir <textarea name="declaration" required maxlength="4000"></textarea></label><label>Auteur <input name="actor" required></label><label><input type="checkbox" name="confirm" value="true" required>Je confirme cette déclaration pour la mémoire partagée</label><button>Enregistrer</button></form>
@foreach(var question in Model.Knowledge.Questions){<article><h3>@question.Text</h3><p>@question.Project</p>
@if(question.Answer!=null){<p>@question.Answer — @question.Actor</p>}
<form method="post" asp-page-handler="Answer"><input type="hidden" name="id" value="@question.Id"><label>Réponse ou correction <textarea name="answer" required maxlength="4000"></textarea></label><label>Auteur <input name="actor" required></label><label><input type="checkbox" name="confirm" value="true" required>Confirmer l'enregistrement</label><button>Répondre</button></form></article>}
}else if(Model.View=="ingestions"){
<h2>Ingestions publiées</h2>
@foreach(var report in Model.Knowledge.Reports.OrderByDescending(r=>r.At)){
<section><h3>@report.SourceId — @report.At.ToString("u")</h3><small>@report.Id</small><p>@(report.Mode == "index" ? "Indexation locale" : "Analyse Copilot") : @report.Files fichiers, @report.Unchanged inchangés. @report.UnanalyzedFiles fichiers sans analyse Copilot préalable.</p>
@foreach(var count in report.Counts.Where(c=>c.Value>0)){<span>@count.Key : @count.Value · </span>}
@foreach(var warning in report.Warnings){<p class="warning">@warning</p>}
</section>}
}else{
@if(Model.View=="search"){<form method="get"><label>Rechercher une entité ou une règle <input name="q" value="@Model.Query"></label><label>Projet (si plusieurs) <input name="project" value="@Model.Project"></label><button>Rechercher</button></form>}
@if(Model.View=="review"){<h2>Décisions à examiner</h2>}
@foreach(var hit in Model.Hits){<article><h2><a href="/?view=detail&amp;id=@hit.Id&amp;project=@Uri.EscapeDataString(hit.Project??"")">@hit.Title</a></h2><p>@hit.Kind · @hit.Project / @hit.Domain · @hit.Role · @hit.State · @hit.Origin · @hit.SourceStatus</p><pre>@hit.Text</pre><small>Retrouvé par : @string.Join(" ; ",hit.Reasons)</small></article>}
@if(Model.Claims.Count==0 && Model.Hits.Length==0){<p>Aucun résultat. Importez vos sources ou précisez votre recherche.</p>}
@foreach(var claim in Model.Claims){
<article><h2><a href="/?view=detail&amp;id=@claim.Id">@Model.Knowledge.Entities.Single(e=>e.Id==claim.EntityId).Name</a></h2><p>@claim.Statement</p>
@if(claim.Context is {} context){<p>Contexte déclaré : @context.Project / @context.Domain — @context.Status</p><p>@context.Description @context.Notes</p>}
<p>@claim.Role · @claim.Contribution · @(claim.Obsolete?"Preuve devenue historique":"Preuve active")</p>
@if(Workspace.Conflict(Model.Decisions,claim.Id)){<p class="warning">Décisions concurrentes incompatibles : arbitrage nécessaire.</p>}
@foreach(var decision in Workspace.Effective(Model.Decisions,claim.Id)){<p>Décision : @decision.Action — @decision.Reason (@decision.Actor)</p>}
@if(Model.View is "detail" or "review"){
@foreach(var evidence in Model.Knowledge.Evidence.Where(e=>claim.EvidenceIds.Contains(e.Id))){<details><summary>@evidence.SourceId/@evidence.RelativePath — @evidence.Locator</summary><small>Version @evidence.Version</small><pre>@evidence.Excerpt</pre></details>}
@foreach(var related in claim.RelatedClaimIds){<p><a href="/?view=detail&amp;id=@related">Connaissance liée : @related</a></p>}
<form method="post"><input type="hidden" name="claimId" value="@claim.Id"><label>Décision <select name="action"><option value="accept">Accepter</option><option value="reject">Rejeter</option><option value="distinct">Concepts distincts</option><option value="replace">Remplace les connaissances liées</option></select></label><label>Justification <textarea name="reason" required maxlength="4000"></textarea></label><label>Votre nom <input name="actor" required maxlength="200"></label><button>Enregistrer la décision</button></form>
}
</article>}
}
</body></html>
