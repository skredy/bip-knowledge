<Application x:Class="BipKb.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ThemeMode="System" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#1C3439"/>
  <SolidColorBrush x:Key="Accent" Color="#14645C"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0,2,0,5"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,7"/></Style>
 </Application.Resources>
</Application>
